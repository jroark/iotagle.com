[Unit]
Description=iotagle Flask app
After=network.target

[Service]
Type=notify
User=iotagle
# The process needs read access to /opt/iotagle/app (mode 2750, owned
# ubuntu:iotagle) — that requires group membership in ``iotagle``, which it
# has by default (the user's primary group).
Group=iotagle
WorkingDirectory=/opt/iotagle/app
Environment=PYTHONUNBUFFERED=1
Environment=IOTAGLE_ENV=prod
ExecStart=/opt/iotagle/venv/bin/gunicorn -c /opt/iotagle/app/deploy/gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=3

# Hardening: most of the filesystem should be invisible / read-only to the
# service. The only writable path it needs is the socket directory.
NoNewPrivileges=yes
# ``ProtectSystem=full`` makes /usr /etc /boot read-only but leaves /run and
# /var writable normally. We previously used ``strict`` + ``ReadWritePaths=
# /run/iotagle``, which caused systemd to bind-mount the runtime directory
# into the service's mount namespace — gunicorn's socket then existed only
# inside that namespace and nginx (on the host) saw an empty directory.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Hard memory cap. On a 512 MB box this leaves room for nginx + journald.
MemoryMax=350M

[Install]
WantedBy=multi-user.target
